# ==========================================
# Trust Computer-Moulvibazar E-commerce Platform
# Environment Configuration Template
# ==========================================

# 1. APPLICATION
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. DATABASE CONFIGURATION
# Production/Staging: Supabase / PostgreSQL Connection String
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trust_computer_db?schema=public"

# 3. AUTHENTICATION & SECURITY
# Secret used for signing JWTs and session cookies (generate with `openssl rand -base64 32`)
AUTH_SECRET="trust_computer_super_secure_auth_secret_change_in_production_key_32bytes"
AUTH_COOKIE_NAME="trust_admin_session"
AUTH_TOKEN_EXPIRY="7d"

# 4. BUSINESS & CONTACT DETAILS
NEXT_PUBLIC_STORE_NAME="Trust Computer-Moulvibazar"
NEXT_PUBLIC_ORGANIZATION="Amdads Group"
NEXT_PUBLIC_LOCATION="T.S Plaza (2nd Floor), Kusumbagh, Moulvibazar, Bangladesh"
NEXT_PUBLIC_PHONE="01753-765372"
NEXT_PUBLIC_WHATSAPP="+8801753765372"
NEXT_PUBLIC_EMAIL="trustcomputermb@gmail.com"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/TrustComputerr/"
NEXT_PUBLIC_STORE_DESCRIPTION="মানসম্মত কম্পিউটার ও সিসি ক্যামেরা জগতে মৌলভীবাজারের একটি বিশ্বস্ত প্রতিষ্ঠান।❤️"

# 5. PAYMENT GATEWAY SETTINGS (bKash / Nagad / SSLCOMMERZ)
# Defaults to manual payment / Cash on Delivery (COD) until merchant onboarding is verified.
PAYMENT_GATEWAY_PROVIDER="COD_MANUAL" # Options: COD_MANUAL, BKASH, SSLCOMMERZ, NAGAD
PAYMENT_TEST_MODE="true"

# bKash Credentials (Configured once merchant account is verified)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# SSLCOMMERZ Credentials (Configured once merchant account is verified)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# 6. STORAGE (Product Images)
# LOCAL for development, SUPABASE_STORAGE or CLOUDINARY or S3 for production
STORAGE_PROVIDER="LOCAL"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_NAME="product-images"
